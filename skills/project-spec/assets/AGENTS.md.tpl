```bash
{{#VUE_TS}}pnpm install            # 安装依赖（pnpm-workspace.yaml 已内置构建脚本白名单，勿删）
pnpm dev                # 开发服务器，http://localhost:{{DEV_PORT}}
{{#BACKEND}}pnpm server             # 存储服务，http://localhost:{{API_PORT}}（数据落 server/data/*.json）
